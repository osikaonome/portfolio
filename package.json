{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/sync-assets.mts",
    "dev": "next dev",
    "prebuild": "tsx scripts/sync-assets.mts && tsx scripts/check-content.mts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check:content": "tsx scripts/check-content.mts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "placeholders": "tsx scripts/generate-placeholders.mts",
    "test:visual": "VISUAL=1 playwright test",
    "build:preview": "ALLOW_TODOS=1 npm run build"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.4",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
